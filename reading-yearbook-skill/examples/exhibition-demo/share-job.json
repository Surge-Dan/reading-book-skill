      "text": "把提问看作澄清边界、寻找证据和暴露假设的工具。",
      "truncated": false,
      "original_characters": 23
    },
    "sample-005/highlight/s5-h1": {
      "kind": "highlight",
      "source_id": "s5-h1",
      "text": "问题决定我们允许什么成为证据。",
      "truncated": false,
      "original_characters": 15,
      "created_at": 1789084800
    },
    "sample-005/highlight/s5-h2": {
      "kind": "highlight",
      "source_id": "s5-h2",
      "text": "先问边界，再问答案。",
      "truncated": false,
      "original_characters": 10,
